\title{Insertion dans un tableau trié}
\author{thibautbenjamin}
\taxon{Exercice}
\date{2025-11-02T11:33:25Z}
\import{basemacros}

\p{\ol{
\li{Ecrire une fonction \code{inserer} qui prend en entrée un entier #{k}, un tableau de taille #{> k} dont les #{k} premières entrées sont triées, et qui insère le contenu de la position #{k} à la bonne place, de manière à ce qu'ensuite les #{k+1} prmières entrées du tableau soient triées}
\li{Evaluer la complexité de cette fonction.}
}}
