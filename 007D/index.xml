        <html:pre><html:code class="language-cpp rainbow-braces line-numbers" data-prismjs-copy="Copier" data-prismjs-copy-error="Erreur" data-prismjs-copy-success="Copié">
<![CDATA[// Entrées: Un entier x positif ou nul
// Sortie: L'entier x incrémenté de 1
#include <iostream>
using namespace std;

int incrementer (int x){
    if (x == 0){
        return 1;
    }
    else{
        return incrementer (x-1) + 1;
    }
    return 0;
}]]>
</html:code></html:pre></html:p>
