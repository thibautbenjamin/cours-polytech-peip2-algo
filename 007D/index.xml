                        <fr:title text="Un algorithme récursif sans progrès vers le cas de base">Un algorithme récursif sans progrès vers le cas de base</fr:title>
                        <fr:taxon>Exemple</fr:taxon>
                      </fr:frontmatter>
                      <fr:mainmatter>
                        <html:p><html:link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/themes/prism.min.css" />
        <html:link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/plugins/match-braces/prism-match-braces.min.css" />
